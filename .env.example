# Copy this file to `.env` and fill in your OWN keys, then keep `.env` private.
# `.env` is gitignored and is never copied into the Docker image — your keys
# stay on your machine and you spend only your own free-tier credits.

# ── Required ────────────────────────────────────────────────────────────────
# The AI enrichment pipeline uses OpenAI to label merchants and categories.
OPENAI_API_KEY=

# ── Optional: web-search providers (recommended) ────────────────────────────
# Used to look up merchant details. Each has a free tier; the pipeline falls
# back through them in order, so adding even one improves results. Get your own
# keys so you never hit someone else's limit. Leave blank to skip a provider.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
SCRAPE_DO_API_KEY=

# ── DATA_DIR ────────────────────────────────────────────────────────────────
# Host folder holding your bank exports — it must contain an  lnd/  subfolder.
# Used for BOTH local and Docker runs:
#   • Local (no Docker): the app reads this path directly.
#   • Docker: compose mounts this folder into the container as /data
#     (the container's own DATA_DIR is overridden to /data automatically).
# May be relative to the repo (e.g. ../bank_data) or an absolute path.
# If left unset, Docker falls back to ./bank_data.
DATA_DIR=/absolute/path/to/your/bank_exports